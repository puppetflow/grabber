#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
version_file="$repo_root/version.txt"
current_version="$(tr -d '[:space:]' < "$version_file")"

if [[ ! "$current_version" =~ ^(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*)){0,3}$ ]]; then
  echo "Invalid extension version: $current_version" >&2
  exit 1
fi

IFS='.' read -r -a parts <<< "$current_version"
has_nonzero=false
for part in "${parts[@]}"; do
  if (( part > 65535 )); then
    echo "Version component exceeds 65535: $part" >&2
    exit 1
  fi
  if (( part > 0 )); then
    has_nonzero=true
  fi
done

if [[ "$has_nonzero" != true ]]; then
  echo "Extension version cannot be all zeros." >&2
  exit 1
fi

last_index=$((${#parts[@]} - 1))
if (( parts[last_index] >= 65535 )); then
  echo "Last version component cannot be incremented beyond 65535." >&2
  exit 1
fi
parts[last_index]=$((parts[last_index] + 1))

new_version="$(IFS='.'; echo "${parts[*]}")"
printf '%s\n' "$new_version" > "$version_file"
